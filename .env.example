# ID da planilha do Google Sheets (ex: o código longo na URL docs.google.com/spreadsheets/d/SEU_ID/edit)
SPREADSHEET_ID=SEU_SPREADSHEET_ID_AQUI
SHEET_GID=0

# URL do Webhook do Google Apps Script (opcional, para atualizar status na planilha online)
APPS_SCRIPT_WEBHOOK_URL=

# Diretório de perfil do Chrome
CHROME_PROFILE_DIR=./chrome_user_data
